{
  "name": "seolin-kit-platform",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm pinball:build && pnpm --filter @seolin/mobile start",
    "android": "pnpm pinball:build && pnpm --filter @seolin/mobile android",
    "android:prebuild": "pnpm pinball:build && pnpm --filter @seolin/mobile android:prebuild",
    "android:studio": "pnpm android:prebuild && node scripts/open-android-studio.mjs",
    "web": "pnpm pinball:build && pnpm --filter @seolin/mobile web",
    "typecheck": "pnpm pinball:build && pnpm --filter @seolin/mobile typecheck",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test",
    "export": "pnpm pinball:build && pnpm --filter @seolin/mobile export",
    "pinball:build": "pnpm --filter @seolin/pinball build",
    "pinball:dev": "pnpm --filter @seolin/pinball dev"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
